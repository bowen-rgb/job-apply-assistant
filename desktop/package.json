{
  "name": "job-apply-assistant-desktop",
  "version": "1.0.8",
  "description": "Local Job Apply Assistant desktop application",
  "author": "Job Apply Assistant contributors",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.jobapplyassistant.desktop",
    "productName": "Job Apply Assistant",
    "directories": {
      "output": "../output/desktop"
    },
    "files": [
      "main.cjs",
      "policy.cjs",
      "backend-ready.cjs",
      "loading.html",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "backend",
        "filter": [
          "app/**",
          "static/**",
          "docs/**",
          "runtime/**",
          "profile.example.json",
          "README.md",
          "LICENSE",
          "runtime-packages.json"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "displayLanguageSelector": true,
      "artifactName": "Job-Apply-Assistant-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  }
}
